<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btn_view_tenants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_tenants"
        android:textSize="20sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_add_tenant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_tenant"
        android:textSize="20sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_record_payment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/record_payment_button_text"
        android:textSize="20sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_generate_invoices_bulk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/generate_invoices_button_text"
        android:textSize="20sp"/>

</LinearLayout>
